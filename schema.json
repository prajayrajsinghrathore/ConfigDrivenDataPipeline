{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SEC Filing Records",
  "type": "array",
  "description": "Array of SEC filing records",
  "items": {
    "type": "object",
    "properties": {
      "cik": {
        "type": "string",
        "pattern": "^[0-9]+$",
        "description": "Central Index Key - unique identifier for the company"
      },
      "form": {
        "type": "string",
        "description": "SEC form type (e.g., 10-K, 10-Q, 8-K, 4, etc.)"
      },
      "symbol": {
        "type": "string",
        "description": "Stock ticker symbol"
      },
      "filedDate": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
        "description": "Date when the filing was submitted (YYYY-MM-DD HH:MM:SS format)"
      },
      "filingUrl": {
        "type": "string",
        "format": "uri",
        "description": "URL to the filing index page on SEC website"
      },
      "reportUrl": {
        "type": "string",
        "format": "uri",
        "description": "URL to the actual filing document"
      },
      "setup_upper": {
        "type": "string",
        "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$",
        "description": "SEC accession number (matches accessNumber format)"
      },
      "acceptedDate": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
        "description": "Date and time when SEC accepted the filing (YYYY-MM-DD HH:MM:SS format)"
      },
      "accessNumber": {
        "type": "string",
        "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$",
        "description": "SEC accession number (unique identifier for each filing)"
      },
      "processed_at": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
        "description": "Timestamp when the record was processed by the system (YYYY-MM-DD HH:MM:SS format)"
      }
    },
    "required": [
      "cik",
      "form",
      "symbol",
      "filedDate",
      "filingUrl",
      "reportUrl",
      "setup_upper",
      "acceptedDate",
      "accessNumber",
      "processed_at"
    ],
    "additionalProperties": false
  }
}
