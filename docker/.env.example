# =============================================================================
# Airflow 3.1.6 Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control!
#
# Generate secrets with:
#   Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   Secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"

# -----------------------------------------------------------------------------
# SECURITY SECRETS (Required)
# -----------------------------------------------------------------------------

# Fernet key for encrypting connection passwords in the database
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=your-32-byte-base64-encoded-key-here

# Internal API secret key for authentication between Airflow components
# Generate: python -c "import secrets; print(secrets.token_urlsafe(16))"
AIRFLOW_INTERNAL_API_SECRET_KEY=your-secret-key-here

# JWT secret for API authentication
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=your-jwt-secret-here

# -----------------------------------------------------------------------------
# AIRFLOW CONFIGURATION
# -----------------------------------------------------------------------------

# User ID for Airflow containers (run `id -u` on Linux to get your UID)
AIRFLOW_UID=50000

# Airflow admin credentials (change in production!)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# -----------------------------------------------------------------------------
# KAFKA CONFIGURATION
# -----------------------------------------------------------------------------

KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC_MARKET_DATA=market-data
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# Circuit breaker settings
KAFKA_CIRCUIT_FAILURE_THRESHOLD=5
KAFKA_CIRCUIT_RECOVERY_TIMEOUT=30.0

# -----------------------------------------------------------------------------
# DATA FETCHER CONFIGURATION
# -----------------------------------------------------------------------------

DATA_FETCHER_TIMEOUT=30
DATA_FETCHER_MAX_RETRIES=3
DATA_FETCHER_RETRY_BACKOFF=1.0

# -----------------------------------------------------------------------------
# SNOWFLAKE CONFIGURATION (Optional)
# -----------------------------------------------------------------------------

# SNOWFLAKE_CONN_ID=snowflake-default
# SNOWFLAKE_DEFAULT_STAGE=DATA_STAGE
# SNOWFLAKE_DEFAULT_STAGE_PATH=DATA

# -----------------------------------------------------------------------------
# AZURE CONFIGURATION (Optional)
# -----------------------------------------------------------------------------

# AZURE_DATA_LAKE_CONN_ID=azure_data_lake_default
# AZURE_BLOB_CONN_ID=azure_blob_default
